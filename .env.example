# =====================================================================
# Mindraft — variabili d'ambiente
# Copia questo file in .env.local e compila almeno le due voci Supabase.
# .env.local è già ignorato da git: non committare mai chiavi reali.
# =====================================================================

# --- Supabase (obbligatorie) -----------------------------------------
# Dashboard Supabase → Project Settings → API
# L'URL del progetto, es. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://wzolehodcwnzvlurbsft.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_openai_api_key_here
# La chiave "anon / public". È pensata per stare nel browser: la
# sicurezza è garantita dalle policy RLS, non dalla segretezza di questa
# chiave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_openai_api_key_here

# --- Supabase service role (opzionale) --------------------------------
# Serve SOLO al webhook Stripe, che deve scrivere una riga che nessun
# utente può scrivere. Non finisce mai nel bundle del browser.
# NON è necessaria per usare l'applicazione.
SUPABASE_SERVICE_ROLE_KEY=your_openai_api_key_here

# --- URL pubblico del sito -------------------------------------------
# Usato per i link di conferma email e di reset password.
NEXT_PUBLIC_SITE_URL=mindraft-iota.vercel.app

# --- Provider AI (opzionale) ------------------------------------------
# Senza chiave l'app usa il provider "mock": è un'implementazione locale
# e deterministica, non una finzione. Tutti i flussi AI restano
# utilizzabili e l'interfaccia dichiara sempre quale motore ha prodotto
# una proposta.
#
# AI_PROVIDER=openai forza l'uso di OpenAI; senza valore viene scelto
# automaticamente openai se OPENAI_API_KEY è presente, altrimenti mock.
AI_PROVIDER=
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Endpoint compatibile con l'API chat-completions di OpenAI (Azure,
# OpenRouter, un modello locale…). Lascia vuoto per usare OpenAI.
OPENAI_BASE_URL=
AI_TIMEOUT_MS=45000

# --- Stripe (opzionale) ------------------------------------------------
# Senza STRIPE_SECRET_KEY la sezione abbonamenti resta in sola lettura e
# il webhook risponde 501: nessuna transazione viene simulata.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PRO=

# --- Test --------------------------------------------------------------
# Impostata automaticamente dalla suite Playwright.
# MINDRAFT_E2E=1
# Per eseguire i test end-to-end su un server già avviato:
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
